# Copia a .env y ajusta. Nunca subas .env a git.
PORT=3000
# Ruta del archivo SQLite (default: backend/data/wine-and-art.db)
DB_PATH=./data/wine-and-art.db
# Origenes permitidos para CORS, separados por coma. Vacio = solo mismo origen.
CORS_ORIGIN=
# Token para GET /api/admin/reservas. Vacio = endpoint deshabilitado.
# Genera uno largo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Opcional: 1 si corre detras de un proxy (Render, etc.) para que el rate limit vea la IP real
TRUST_PROXY=
# Opcional: maximo de reservas por IP en la ventana (default 10 por 15 min)
RATE_LIMIT_MAX=10
# Intentos totales (incluye 400/409) por IP cada 15 min; proteccion anti-abuso
RATE_LIMIT_ATTEMPTS_MAX=30
